# PolicyRaj Dashboard — shared configuration for all provisioning scripts.
# Every name here is NEW. Nothing in this file refers to a pre-existing resource.

AWS_REGION="ap-south-1"

POOL_NAME="policyraj-users"
APP_CLIENT_NAME="policyraj-dashboard"
HOSTED_UI_PREFIX="policyraj"          # -> policyraj.auth.ap-south-1.amazoncognito.com
ADMIN_GROUP="admin"

TABLE_NAME="policyraj-dashboard"
BUCKET_NAME="policyraj-user-documents"

READ_FN="policyraj-dashboard-read"
SAVE_FN="policyraj-dashboard-save"
ADMIN_FN="policyraj-dashboard-admin"

READ_ROLE="policyraj-dashboard-read-role"
SAVE_ROLE="policyraj-dashboard-save-role"
ADMIN_ROLE="policyraj-dashboard-admin-role"

# Section 10 specifies https://policyraj.com. The live site also serves www, and a
# browser on www would fail CORS against the apex alone, so both are allowed.
ALLOWED_ORIGIN="https://policyraj.com"
ALLOWED_ORIGIN_WWW="https://www.policyraj.com"

# Budget alert (section 12). The account bills in USD, so the spec's Rs 500/month
# ceiling is set here as its approximate USD equivalent.
BUDGET_NAME="policyraj-dashboard-guardrail"
BUDGET_AMOUNT="6"
BUDGET_CURRENCY="USD"
BUDGET_EMAIL="sachin@policyraj.in"

# Renewal reminders (daily EventBridge schedule -> Lambda -> SES).
# The SES identity below is READ ONLY to this build: the reminder function calls
# ses:SendEmail as sachin@policyraj.in and never touches the domain identity,
# its MAIL FROM subdomain, or its DKIM/SPF/DMARC records.
REMINDER_FN="policyraj-dashboard-reminder"
REMINDER_ROLE="policyraj-dashboard-reminder-role"
REMINDER_RULE="policyraj-dashboard-reminder-daily"

# 03:30 UTC = 09:00 IST. rate() is avoided deliberately: it fires relative to
# creation time, so the send hour would drift to whenever the rule was made.
REMINDER_SCHEDULE="cron(30 3 * * ? *)"

REMINDER_FROM="sachin@policyraj.in"
REMINDER_SENDER_NAME="PolicyRaj"
